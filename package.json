{
  "name": "meteoschweiz-opendata-explorer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test-ci": "ng test --no-watch --no-progress --code-coverage --browsers=ChromeHeadless",
    "prepare": "husky",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find --translations-path public/i18n --emit-error-on-extra-keys",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "lint": "ng lint",
    "type:check": "tsc --noEmit",
    "generate-stac-api": "swagger-typescript-api -p https://sys-data.int.bgdi.ch/api/stac/static/spec/v1/openapi.yaml -o ./src/app/stac/generated -n stac-api.generated.ts --clean-output --extract-response-body --extract-request-body --extract-request-body --api-class-name StacApiClient"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@iframe-resizer/child": "^5.5.7",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/router-store": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "immer": "^10.2.0",
    "maplibre-gl": "^5.12.0",
    "papaparse": "^5.5.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@jsverse/transloco-keys-manager": "^8.1.1",
    "@ngrx/eslint-plugin": "^21.1.1",
    "@types/jasmine": "~6.0.0",
    "@types/papaparse": "^5.5.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-rxjs-angular-x": "^1.0.1",
    "eslint-plugin-rxjs-x": "^1.0.4",
    "husky": "^9.1.7",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.2",
    "swagger-typescript-api": "^13.2.16",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.66.0"
  }
}

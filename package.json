{
  "name": "meteoschweiz-opendata-explorer",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test-ci": "ng test --no-watch --no-progress --code-coverage --browsers=ChromeHeadless",
    "e2e": "playwright test",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "prepare": "husky",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find --translations-path public/i18n --emit-error-on-extra-keys",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "lint": "ng lint",
    "type:check": "tsc --noEmit",
    "generate-stac-api": "swagger-typescript-api generate -p https://sys-data.int.bgdi.ch/api/stac/static/spec/v1/openapi.yaml -o ./src/app/stac/generated -n stac-api.generated.ts --clean-output --extract-response-body --extract-request-body --extract-request-body --api-class-name StacApiClient && prettier --write ./src/app/stac/generated"
  },
  "private": true,
  "engines": {
    "node": "24.19.0"
  },
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@iframe-resizer/child": "^5.5.9",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/router-store": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "immer": "^11.1.15",
    "maplibre-gl": "^6.1.0",
    "papaparse": "^5.5.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@jsverse/transloco-keys-manager": "^8.1.1",
    "@ngrx/eslint-plugin": "^21.1.1",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~6.0.0",
    "@types/papaparse": "^5.5.2",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-rxjs-angular-x": "^1.0.1",
    "eslint-plugin-rxjs-x": "^1.0.4",
    "husky": "^9.1.7",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "swagger-typescript-api": "^13.12.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
